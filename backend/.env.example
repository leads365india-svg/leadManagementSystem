# ==============================================================================
# Leads-365 Environment Configuration Template
# ==============================================================================

# Server & Runtime Environment
PORT=5000
NODE_ENV=development
# In production on Render, set FRONTEND_URL to your Vercel frontend domain(s), comma-separated.
# Supports wildcard domains for preview deployments (e.g. https://*.vercel.app).
# Example: FRONTEND_URL=https://leads-365.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:3000
# Public Backend URL (used for generating email verification / invitation / webhook links)
# Example: BACKEND_URL=https://your-backend.onrender.com
BACKEND_URL=http://localhost:5000

# Primary Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leads_365?retryWrites=true&w=majority

# Authentication & Security
# Must be at least 32 characters in production. Never use placeholder secrets in production.
JWT_SECRET=your-minimum-32-characters-secure-jwt-secret-here

# Super Admin Bootstrap Credentials
SUPERADMIN_EMAIL=superadmin@leadflow.io
SUPERADMIN_PASSWORD=SuperAdmin@2026!
SUPERADMIN_NAME=LeadFlow Super Admin

# Data Encryption (Phase 11: Credentials & Integration Key Encryption, AES-GCM 256-bit)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encoded-aes-256-encryption-key-here

# Background Queue & Scheduler (Phase 9: BullMQ & Redis)
REDIS_URL=redis://127.0.0.1:6379

# Call Recording Storage & Retention (Phase 16: GridFS & 30-Day Purge)
# Recommended: Separate MongoDB cluster/database for recording audio files
RECORDING_RETENTION_DAYS=30
RECORDING_STORAGE_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leads_recordings?retryWrites=true&w=majority

# Mobile App & Push Notifications (Phase 15: Firebase Cloud Messaging)
FCM_SERVER_KEY=your-firebase-cloud-messaging-server-key-here

# Meta Lead Ads Integration (Phase 12: Facebook & Instagram Lead Ads)
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here
META_VERIFY_TOKEN=your-custom-meta-webhook-verify-token-here

# Google Ads Integration (Phase 23: Lead Form Webhook)
GOOGLE_ADS_WEBHOOK_KEY=your-google-ads-webhook-key-here

# IndiaMART Integration (Phase 25: CRM Key / Polling API)
INDIAMART_CRM_KEY=your-indiamart-crm-key-here

# Cloud Telephony Fallback (Phase 33: Optional Exotel / Twilio click-to-call)
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=your-exotel-subdomain-or-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_CALLER_ID=your-exotel-virtual-number

# AI Transcription & Call Summary (Phase 32: Optional Whisper / Deepgram)
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
DEEPGRAM_API_KEY=your-deepgram-api-key-here


# ==============================================================================
# Cloud Media Storage (ImageKit.io Integration)
# ==============================================================================
# Read credentials from your ImageKit Developer Options dashboard.
# Never expose IMAGEKIT_PRIVATE_KEY to the frontend or git repositories.
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key-here
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key-here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
