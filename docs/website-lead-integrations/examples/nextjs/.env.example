# Next.js Server-Side Integration Environment Variables
# CRITICAL SECURITY RULE: NEVER prefix these credentials with NEXT_PUBLIC_

# Leads365 Webhook Intake Endpoint
LEADS365_WEBHOOK_URL="https://crm.yourcompany.com/api/integrations/leads/website"

# Private Integration API Key (lf_live_...) generated in Integration Studio
LEADS365_API_KEY="lf_live_your_private_integration_api_key_here"

# Optional public Site Key if using client-side fallback
# NEXT_PUBLIC_LEADS365_SITE_KEY="lf_site_optional_public_key"
