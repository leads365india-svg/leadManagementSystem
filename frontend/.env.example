# ==============================================================================
# Leads-365 Frontend Environment Configuration
# ==============================================================================
#
# Production Backend API URL:
# Configure this in Vercel Project Settings > Environment Variables:
#   NEXT_PUBLIC_API_URL=https://<your-render-backend-subdomain>.onrender.com/api
#
# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Internal backend URL for server-side Next.js proxy rewrites
# INTERNAL_BACKEND_URL=https://<your-render-backend-subdomain>.onrender.com
